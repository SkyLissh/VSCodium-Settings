{
	"editor.suggestSelection": "first",
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.rulers": [100],
	"prettier.arrowParens": "always",
	"prettier.bracketSpacing": true,
	"prettier.htmlWhitespaceSensitivity": "css",
	"prettier.insertPragma": false,
	"prettier.bracketSameLine": false,
	"prettier.jsxSingleQuote": false,
	"prettier.proseWrap": "preserve",
	"prettier.quoteProps": "as-needed",
	"prettier.requirePragma": false,
	"prettier.semi": true,
	"prettier.singleQuote": false,
	"prettier.trailingComma": "none",
	"prettier.useTabs": true,
	"prettier.vueIndentScriptAndStyle": false,
	"prettier.printWidth": 100,
	"editor.formatOnPaste": true,
	"editor.formatOnSave": true,
	"editor.formatOnType": true,
	"prettier.tabWidth": 2,
	"php.suggest.basic": false,
	"workbench.iconTheme": "symbols",
	"files.exclude": {
		"**/__pycache__": true,
		"**/.git": false
	},
	"editor.insertSpaces": true,
	"editor.tabSize": 2,
	"editor.fontFamily": "'Geist Mono', 'GeistMono Nerd Font'",
	"editor.fontSize": 14.5,
	"editor.fontWeight": "600",
	"editor.fontLigatures": "'ss11', 'ss05'",
	"editor.quickSuggestions": {
		"other": true,
		"comments": true,
		"strings": true
	},
	"editor.codeActionsOnSave": {
		"source.organizeImports": "explicit",
		"source.fixAll": "explicit"
	},
	"html.format.wrapLineLength": 100,
	"html.format.wrapAttributes": "auto",
	"terminal.integrated.fontSize": 13,
	"terminal.integrated.fontWeight": "bold",
	"terminal.integrated.fontFamily": "'Geist Mono', 'GeistMono Nerd Font'",
	"[dart]": {
		"editor.formatOnSave": true,
		"editor.formatOnType": true,
		"editor.rulers": [100],
		"editor.selectionHighlight": false,
		"editor.suggest.snippetsPreventQuickSuggestions": false,
		"editor.suggestSelection": "first",
		"editor.tabCompletion": "onlySnippets",
		"editor.wordBasedSuggestions": "off",
		"editor.defaultFormatter": "Dart-Code.dart-code",
		"editor.insertSpaces": true,
		"editor.detectIndentation": false,
		"editor.suggest.insertMode": "replace",
		"editor.codeActionsOnSave": {
			"source.organizeImports": "never"
		}
	},
	"[python]": {
		"editor.defaultFormatter": "ms-python.black-formatter",
		"editor.codeActionsOnSave": {
			"source.fixAll": "explicit",
			"source.organizeImports": "explicit"
		},
		"editor.formatOnSave": true,
		"editor.tabSize": 4,
		"editor.insertSpaces": true,
		"editor.formatOnType": true
	},
	"python.analysis.completeFunctionParens": true,
	"[django-html]": {
		"editor.quickSuggestions": {
			"other": true,
			"comments": true,
			"strings": true
		}
	},
	"[csharp]": {
		"editor.defaultFormatter": "csharpier.csharpier-vscode",
		"editor.formatOnSave": true,
		"editor.tabSize": 2
	},
	"[razor]": {
		"editor.defaultFormatter": "ms-dotnettools.csharp",
		"editor.formatOnSave": true,
		"editor.tabSize": 2
	},
	"[docker]": {
		"editor.defaultFormatter": "ms-azuretools.vscode-docker"
	},
	"emmet.includeLanguages": {
		"django-html": "html"
	},
	"vim.leader": "<space>",
	"vim.easymotion": true,
	"vim.incsearch": true,
	"vim.useSystemClipboard": true,
	"vim.useCtrlKeys": true,
	"vim.hlsearch": true,
	"files.associations": {
		"*.rmd": "markdown",
		"**/*.html": "html",
		"**/templates/**/*.html": "django-html",
		"**/templates/**/*": "django-txt",
		"*.css": "tailwindcss",
		"**/requirements{/**,*}.{txt,in}": "pip-requirements",
		"*.arb": "json"
	},
	"editor.semanticHighlighting.enabled": true,
	"editor.minimap.enabled": false,
	"workbench.editorAssociations": {
		"*.ipynb": "jupyter-notebook"
	},
	"editor.inlineSuggest.enabled": true,
	"terminal.integrated.defaultProfile.windows": "Nushell",
	"markdownlint.config": {
		"no-inline-html": false,
		"$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/v0.40.0/schema/markdownlint-config-schema.json"
	},
	"security.workspace.trust.untrustedFiles": "open",
	"[aspnetcorerazor]": {
		"editor.defaultFormatter": "ms-dotnettools.csharp"
	},
	"[dockercompose]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},
	"editor.bracketPairColorization.enabled": true,
	"editor.mouseWheelZoom": true,
	"js/ts.tsserver.log": "off",
	"python.analysis.typeCheckingMode": "strict",
	"redhat.telemetry.enabled": false,
	"files.eol": "\n",
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"prettier.endOfLine": "auto",
	"[go]": {
		"editor.defaultFormatter": "golang.go",
		"editor.insertSpaces": true
	},
	"highlight.regexes": {
		"((?:<!-- *)?(?:#|// @|//|./\\*+|<!--|--|\\* @|{!|{{!--|{{!) *TODO(?:\\s*\\([^)]+\\))?:?)((?!\\w)(?: *-->| *\\*/| *!}| *--}}| *}}|(?= *(?:[^:]//|/\\*+|<!--|@|--|{!|{{!--|{{!))|(?: +[^\\n@]*?)(?= *(?:[^:]//|/\\*+|<!--|@|--(?!>)|{!|{{!--|{{!))|(?: +[^@\\n]+)?))": {
			"filterFileRegex": ".*(?<!CHANGELOG.md)$",
			"decorations": [
				{
					"overviewRulerColor": "#ffcc00",
					"backgroundColor": "#ffcc00",
					"color": "#1f1f1f",
					"fontWeight": "bold"
				},
				{
					"backgroundColor": "#ffcc00",
					"color": "#1f1f1f"
				}
			]
		},
		"((?:<!-- *)?(?:#|// @|//|./\\*+|<!--|--|\\* @|{!|{{!--|{{!) *(?:FIXME|FIX|BUG|UGLY|DEBUG|HACK)(?:\\s*\\([^)]+\\))?:?)((?!\\w)(?: *-->| *\\*/| *!}| *--}}| *}}|(?= *(?:[^:]//|/\\*+|<!--|@|--|{!|{{!--|{{!))|(?: +[^\\n@]*?)(?= *(?:[^:]//|/\\*+|<!--|@|--(?!>)|{!|{{!--|{{!))|(?: +[^@\\n]+)?))": {
			"filterFileRegex": ".*(?<!CHANGELOG.md)$",
			"decorations": [
				{
					"overviewRulerColor": "#cc0000",
					"backgroundColor": "#cc0000",
					"color": "#1f1f1f",
					"fontWeight": "bold"
				},
				{
					"backgroundColor": "#cc0000",
					"color": "#1f1f1f"
				}
			]
		},
		"((?:<!-- *)?(?:#|// @|//|./\\*+|<!--|--|\\* @|{!|{{!--|{{!) *(?:REVIEW|OPTIMIZE|TSC)(?:\\s*\\([^)]+\\))?:?)((?!\\w)(?: *-->| *\\*/| *!}| *--}}| *}}|(?= *(?:[^:]//|/\\*+|<!--|@|--|{!|{{!--|{{!))|(?: +[^\\n@]*?)(?= *(?:[^:]//|/\\*+|<!--|@|--(?!>)|{!|{{!--|{{!))|(?: +[^@\\n]+)?))": {
			"filterFileRegex": ".*(?<!CHANGELOG.md)$",
			"decorations": [
				{
					"overviewRulerColor": "#00ccff",
					"backgroundColor": "#00ccff",
					"color": "#1f1f1f",
					"fontWeight": "bold"
				},
				{
					"backgroundColor": "#00ccff",
					"color": "#1f1f1f"
				}
			]
		},
		"((?:<!-- *)?(?:#|// @|//|./\\*+|<!--|--|\\* @|{!|{{!--|{{!) *(?:IDEA)(?:\\s*\\([^)]+\\))?:?)((?!\\w)(?: *-->| *\\*/| *!}| *--}}| *}}|(?= *(?:[^:]//|/\\*+|<!--|@|--|{!|{{!--|{{!))|(?: +[^\\n@]*?)(?= *(?:[^:]//|/\\*+|<!--|@|--(?!>)|{!|{{!--|{{!))|(?: +[^@\\n]+)?))": {
			"filterFileRegex": ".*(?<!CHANGELOG.md)$",
			"decorations": [
				{
					"overviewRulerColor": "#cc00cc",
					"backgroundColor": "#cc00cc",
					"color": "#1f1f1f",
					"fontWeight": "bold"
				},
				{
					"backgroundColor": "#cc00cc",
					"color": "#1f1f1f"
				}
			]
		},
		"(\"@_[A-Z_]+\": {},)": {
			"filterFileRegex": ".*\\.arb",
			"decorations": [
				{
					"overviewRulerColor": "#d19a66",
					"backgroundColor": "#ff6188",
					"color": "#fcfcfa",
					"fontWeight": "bold"
				}
			]
		}
	},
	"[xml]": {
		"editor.defaultFormatter": "redhat.vscode-xml"
	},
	"terminal.integrated.defaultProfile.linux": "fish",
